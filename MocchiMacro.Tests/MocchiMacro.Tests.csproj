<!--
  Tests for MocchiMacro. They drive the typist through a fake game port, so they run
  instantly and need no game. Run them from Visual Studio's Test Explorer, or build and
  run the test executable directly:
    bin/Debug/net48/MocchiMacro.Tests.exe
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- MSTest's own runner (Microsoft.Testing.Platform) makes the test project an executable,
         so Test Explorer can run it without the separate Microsoft.NET.Test.Sdk package. -->
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MocchiMacro\MocchiMacro.csproj" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
