<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares Windows 10 support. Without it Windows reports an older version to the app, and
  Windows Forms then won't turn on the PerMonitorV2 DPI awareness set in App.config. DPI
  awareness itself is set there, not here: a dpiAware setting in this manifest would override it.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MocchiMacro.app"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
