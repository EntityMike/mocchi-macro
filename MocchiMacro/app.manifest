<?xml version="1.0" encoding="utf-8"?>
<!--
  Embedded in MocchiMacro.exe at build time.

  Declares PerMonitorV2 DPI awareness, so at Windows display scaling above 100% the game
  window's client area and the click points are real pixels instead of scaled-down ones, and
  the tool's window is drawn sharp. It's declared here so the .exe can ship alone, with no
  config file next to it. It's the manifest rather than a SetProcessDpiAwarenessContext call
  in Main because the manifest always applies before any window exists; the call fails
  silently if anything sets awareness first.

  Also declares Windows 10 support, so Windows runs the tool as a Windows 10 app. Without it,
  Windows applies compatibility behaviour meant for older apps and reports an older version.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MocchiMacro.app"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
